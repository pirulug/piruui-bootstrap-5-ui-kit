.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#navs.mb-3 Navigation & Tabs

  //- ==========================
  //- TABS & PILLS
  //- ==========================
  .row.g-3.mb-3
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Tabs Navigation
          ul.nav.nav-tabs.mb-3(role='tablist')
            li.nav-item(role='presentation')
              a.nav-link.active(data-bs-toggle='tab' href='#home' aria-selected='true' role='tab') General
            li.nav-item(role='presentation')
              a.nav-link(data-bs-toggle='tab' href='#profile' aria-selected='false' role='tab' tabindex='-1') Permisos
            li.nav-item(role='presentation')
              a.nav-link.disabled(href='#' aria-selected='false' tabindex='-1' role='tab') Deshabilitado
          
          #myTabContent.tab-content
            #home.tab-pane.fade.show.active(role='tabpanel')
              p Configuracion general de la cuenta y preferencias de interfaz.
            #profile.tab-pane.fade(role='tabpanel')
              p Permisos y roles asignados a los usuarios del equipo.
    
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Pills Navigation
          ul.nav.nav-pills.mb-3
            li.nav-item
              a.nav-link.active(href='#') Todos
            li.nav-item
              a.nav-link(href='#') Pendientes
            li.nav-item
              a.nav-link(href='#') Completados
            li.nav-item
              a.nav-link.disabled(href='#') Archivados

          h3.h5.text-muted.mb-2 Underline Nav (Bootstrap 5.3)
          ul.nav.nav-underline
            li.nav-item
              a.nav-link.active(aria-current='page' href='#') Resumen
            li.nav-item
              a.nav-link(href='#') Metricas
            li.nav-item
              a.nav-link(href='#') Reportes

  //- ==========================
  //- VERTICAL TABS & BREADCRUMBS
  //- ==========================
  .row.g-3.mb-3
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Vertical Tabs Layout
          .row.g-3
            .col-md-4
              #v-pills-tab.nav.flex-column.nav-pills(role='tablist' aria-orientation='vertical')
                a#v-pills-home-tab.nav-link.active(data-bs-toggle='pill' href='#v-pills-home' role='tab' aria-controls='v-pills-home' aria-selected='true')
                  i.bi.bi-speedometer2.me-1
                  | Panel
                a#v-pills-profile-tab.nav-link(data-bs-toggle='pill' href='#v-pills-profile' role='tab' aria-controls='v-pills-profile' aria-selected='false')
                  i.bi.bi-person.me-1
                  | Perfil
                a#v-pills-settings-tab.nav-link(data-bs-toggle='pill' href='#v-pills-settings' role='tab' aria-controls='v-pills-settings' aria-selected='false')
                  i.bi.bi-gear.me-1
                  | Ajustes
            .col-md-8
              #v-pills-tabContent.tab-content
                #v-pills-home.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='v-pills-home-tab')
                  p Vista principal con estadisticas de la cuenta.
                #v-pills-profile.tab-pane.fade(role='tabpanel' aria-labelledby='v-pills-profile-tab')
                  p Gestion de perfil y datos personales.
                #v-pills-settings.tab-pane.fade(role='tabpanel' aria-labelledby='v-pills-settings-tab')
                  p Preferencias y opciones avanzadas.

    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Breadcrumbs
          nav(aria-label='breadcrumb')
            ol.breadcrumb.mb-3
              li.breadcrumb-item
                a(href='#') Inicio
              li.breadcrumb-item
                a(href='#') Productos
              li.breadcrumb-item.active(aria-current='page') Categoria Electronica

          h2.h4.mb-3 Standard Paginator
          nav(aria-label='Paginacion simple')
            ul.pagination.mb-0
              li.page-item.disabled
                a.page-link(href='#')
                  i.bi.bi-chevron-left
              li.page-item.active
                a.page-link(href='#') 1
              li.page-item
                a.page-link(href='#') 2
              li.page-item
                a.page-link(href='#') 3
              li.page-item
                a.page-link(href='#')
                  i.bi.bi-chevron-right