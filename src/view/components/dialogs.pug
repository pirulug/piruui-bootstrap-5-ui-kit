.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#dialogs.mb-3 Dialogs, Modals & Notifications

  .row.g-3
    //- ==========================
    //- MODALS & OFFCANVAS
    //- ==========================
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Modals & Dialogs
          
          //- Static Modal Preview
          .modal.position-static.d-block.mb-3(tabindex='-1')
            .modal-dialog(role='document')
              .modal-content
                .modal-header
                  h5.modal-title Confirm Action
                  button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
                .modal-body
                  p Are you sure you want to proceed with this operation? This action cannot be undone.
                .modal-footer
                  button.btn.btn-outline-secondary.text-uppercase.small.fw-bold(type='button' data-bs-dismiss='modal') Cancel
                  button.btn.btn-primary.text-uppercase.small.fw-bold(type='button') Confirm
          
          //- Live Triggers
          .d-flex.flex-wrap.gap-2.mb-3
            button.btn.btn-primary(type='button' data-bs-toggle='modal' data-bs-target='#exampleModalLive')
              i.bi.bi-window.me-1
              | Launch Standard Modal
            button.btn.btn-outline-danger(type='button' data-bs-toggle='modal' data-bs-target='#confirmDeleteModalLive')
              i.bi.bi-trash.me-1
              | Delete Confirmation Modal

      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Offcanvas Drawers
          .d-flex.flex-wrap.gap-2
            button.btn.btn-primary(type='button' data-bs-toggle='offcanvas' data-bs-target='#offcanvasExample' aria-controls='offcanvasExample')
              i.bi.bi-layout-sidebar.me-1
              | Start Offcanvas (Left)
            button.btn.btn-secondary(type='button' data-bs-toggle='offcanvas' data-bs-target='#offcanvasRight' aria-controls='offcanvasRight')
              i.bi.bi-layout-sidebar-reverse.me-1
              | End Offcanvas (Right)

    //- ==========================
    //- POPOVERS, TOOLTIPS & TOASTS
    //- ==========================
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Popovers & Tooltips
          
          h3.h5.text-muted.mb-2 Popovers
          .d-flex.flex-wrap.gap-2.mb-3
            button.btn.btn-outline-secondary(type='button' data-bs-container='body' data-bs-toggle='popover' data-bs-placement='top' data-bs-content='Top popover content.') Top
            button.btn.btn-outline-secondary(type='button' data-bs-container='body' data-bs-toggle='popover' data-bs-placement='bottom' data-bs-content='Bottom popover content.') Bottom
            button.btn.btn-outline-secondary(type='button' data-bs-container='body' data-bs-toggle='popover' data-bs-placement='left' data-bs-content='Left popover content.') Left
            button.btn.btn-outline-secondary(type='button' data-bs-container='body' data-bs-toggle='popover' data-bs-placement='right' data-bs-content='Right popover content.') Right

          h3.h5.text-muted.mb-2 Tooltips
          .d-flex.flex-wrap.gap-2
            button.btn.btn-outline-primary(type='button' data-bs-toggle='tooltip' data-bs-placement='top' title='Tooltip on top') Tooltip Top
            button.btn.btn-outline-primary(type='button' data-bs-toggle='tooltip' data-bs-placement='bottom' title='Tooltip on bottom') Tooltip Bottom
            button.btn.btn-outline-primary(type='button' data-bs-toggle='tooltip' data-bs-placement='left' title='Tooltip on left') Tooltip Left
            button.btn.btn-outline-primary(type='button' data-bs-toggle='tooltip' data-bs-placement='right' title='Tooltip on right') Tooltip Right

      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Toasts & System Notifications
          
          .toast.show.mb-2(role='alert' aria-live='assertive' aria-atomic='true')
            .toast-header
              span.badge.rounded-circle.p-1.bg-success.me-2
              strong.me-auto PiruUI System
              small.text-muted Just now
              button.btn-close(type='button' data-bs-dismiss='toast' aria-label='Close')
            .toast-body
              | Your deployment was successfully completed.

          .toast.show.align-items-center.text-white.bg-primary(role='alert' aria-live='assertive' aria-atomic='true')
            .d-flex
              .toast-body
                i.bi.bi-check-circle-fill.me-2
                | File successfully exported to cloud storage.
              button.btn-close.btn-close-white.me-2.m-auto(type='button' data-bs-dismiss='toast' aria-label='Close')

//- ==========================
//- HIDDEN ELEMENTS (Live triggers)
//- ==========================

#exampleModalLive.modal.fade(tabindex='-1' aria-labelledby='exampleModalLiveLabel' aria-hidden='true')
  .modal-dialog
    .modal-content
      .modal-header
        h5#exampleModalLiveLabel.modal-title Standard Modal
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
      .modal-body
        p This is an interactive live modal running on Bootstrap 5 with PiruUI styling.
      .modal-footer
        button.btn.btn-outline-secondary(type='button' data-bs-dismiss='modal') Close
        button.btn.btn-primary(type='button') Save changes

#confirmDeleteModalLive.modal.fade(tabindex='-1' aria-labelledby='confirmDeleteModalLabel' aria-hidden='true')
  .modal-dialog
    .modal-content
      .modal-header
        h5#confirmDeleteModalLabel.modal-title Eliminar Registro
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
      .modal-body
        p Esta accion eliminara permanentemente el registro seleccionado de la base de datos.
      .modal-footer
        button.btn.btn-outline-secondary(type='button' data-bs-dismiss='modal') Cancelar
        button.btn.btn-danger.text-uppercase.fw-bold(type='button') Eliminar

#offcanvasExample.offcanvas.offcanvas-start(tabindex='-1' aria-labelledby='offcanvasExampleLabel')
  .offcanvas-header
    h5#offcanvasExampleLabel.offcanvas-title Navigation Menu
    button.btn-close.text-reset(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
  .offcanvas-body
    p Left side offcanvas drawer panel.
    ul.list-group.mb-3
      li.list-group-item: a(href='#') Dashboard
      li.list-group-item: a(href='#') Products
      li.list-group-item: a(href='#') Orders

#offcanvasRight.offcanvas.offcanvas-end(tabindex='-1' aria-labelledby='offcanvasRightLabel')
  .offcanvas-header
    h5#offcanvasRightLabel.offcanvas-title User Notifications
    button.btn-close(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
  .offcanvas-body
    p Right side offcanvas drawer for notifications and activity logs.