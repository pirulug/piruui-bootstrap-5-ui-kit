.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#tables.mb-3 Tables & Data Lists

  //- 1. PIRUADMIN COMPLETE DATA LIST (Standard Suite)
  .row
    .col-lg-12
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 PiruAdmin Data Table Suite (Filters + Table + Pagination)
        
        //- Top Filters & Main Action Container
        .bg-body.p-3.mb-3.text-end
          a.btn.btn-primary.text-uppercase.fw-bold(href='#')
            i.bi.bi-plus-lg.me-1
            span Nuevo Usuario
          hr.my-2

          form(method='GET' autocomplete='off')
            .d-flex.flex-wrap.justify-content-end.align-items-center.gap-2
              select.form-select.w-auto(name='role' aria-label='Todos los roles')
                option(value='') Todos los roles
                option(value='admin') Administrador
                option(value='editor') Editor
                option(value='viewer') Visualizador

              select.form-select.w-auto(name='status' aria-label='Todos los estados')
                option(value='') Todos los estados
                option(value='1') Activos
                option(value='0') Inactivos

              .input-group.w-auto.flex-grow-1(style='max-width: 450px;')
                input.form-control(type='text' name='search' placeholder='Buscar por nombre, correo o rol...')
                button.btn.btn-primary.px-3.text-uppercase.small.fw-bold.text-nowrap(type='submit')
                  i.bi.bi-search.me-1
                  | Filtrar

        //- Table Container
        .bg-body.p-3.mb-3
          .table-responsive
            table.table.table-hover.align-middle.table-sm.m-0
              thead
                tr
                  th.ps-2.text-uppercase.fw-bold.text-nowrap Usuario
                  th.text-uppercase.fw-bold.text-nowrap Rol
                  th.text-uppercase.fw-bold.text-nowrap Departamento
                  th.text-uppercase.fw-bold.text-nowrap Estado
                  th.text-uppercase.fw-bold.text-nowrap Fecha de Registro
                  th.text-end.pe-3.text-uppercase.fw-bold.text-nowrap Acciones
              tbody
                tr
                  td.ps-2
                    .d-flex.align-items-center
                      .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center.me-2(style='width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem')
                        | JD
                      div
                        .fw-bold.text-body Jane Doe
                        .small.text-body-secondary jane.doe@example.com
                  td
                    span.badge.bg-primary-subtle.text-primary Administrador
                  td Ingenieria
                  td
                    span.badge.bg-success Activo
                  td 12 Ene 2026
                  td.text-end.pe-3.text-nowrap
                    .d-flex.justify-content-end.gap-1
                      a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-eye.me-1
                        | Ver
                      a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-pencil.me-1
                        | Editar
                      button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type='button')
                        i.bi.bi-trash.me-1
                        | Eliminar
                tr
                  td.ps-2
                    .d-flex.align-items-center
                      .rounded-circle.bg-secondary.text-white.d-flex.align-items-center.justify-content-center.me-2(style='width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem')
                        | AS
                      div
                        .fw-bold.text-body Alex Smith
                        .small.text-body-secondary alex.smith@example.com
                  td
                    span.badge.bg-info-subtle.text-info Editor
                  td Marketing
                  td
                    span.badge.bg-success Activo
                  td 18 Feb 2026
                  td.text-end.pe-3.text-nowrap
                    .d-flex.justify-content-end.gap-1
                      a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-eye.me-1
                        | Ver
                      a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-pencil.me-1
                        | Editar
                      button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type='button')
                        i.bi.bi-trash.me-1
                        | Eliminar
                tr
                  td.ps-2
                    .d-flex.align-items-center
                      .rounded-circle.bg-warning.text-dark.d-flex.align-items-center.justify-content-center.me-2(style='width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem')
                        | CR
                      div
                        .fw-bold.text-body Carlos Ruiz
                        .small.text-body-secondary carlos.ruiz@example.com
                  td
                    span.badge.bg-secondary-subtle.text-secondary Visualizador
                  td Soporte
                  td
                    span.badge.bg-danger Inactivo
                  td 05 Mar 2026
                  td.text-end.pe-3.text-nowrap
                    .d-flex.justify-content-end.gap-1
                      a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-eye.me-1
                        | Ver
                      a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href='#')
                        i.bi.bi-pencil.me-1
                        | Editar
                      button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type='button')
                        i.bi.bi-trash.me-1
                        | Eliminar

        //- Pagination Container
        .bg-body.p-3.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-2.mb-3
          .legend
            span.fw-bold Mostrando 1 - 3 de 24 usuarios
          .paginator
            nav(aria-label='Paginacion')
              ul.pagination.justify-content-end.mb-0
                li.page-item.disabled
                  a.page-link.text-uppercase.small.fw-bold(href='#' aria-label='Primera')
                    i.bi.bi-chevron-double-left.small
                li.page-item.disabled
                  a.page-link(href='#' aria-label='Anterior')
                    i.bi.bi-chevron-left.small
                li.page-item.active
                  a.page-link(href='#') 1
                li.page-item
                  a.page-link(href='#') 2
                li.page-item
                  a.page-link(href='#') 3
                li.page-item.disabled
                  span.page-link ...
                li.page-item
                  a.page-link(href='#') 8
                li.page-item
                  a.page-link(href='#' aria-label='Siguiente')
                    i.bi.bi-chevron-right.small
                li.page-item
                  a.page-link.text-uppercase.small.fw-bold(href='#' aria-label='Ultima')
                    i.bi.bi-chevron-double-right.small

  //- 2. CONTEXTUAL & STRIPED TABLES
  .row.g-3
    .col-lg-6
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 Contextual Rows (Hover)
        .bg-body.p-3
          .table-responsive
            table.table.table-hover.align-middle.table-sm.m-0
              thead
                tr
                  th.text-uppercase.fw-bold Estado
                  th.text-uppercase.fw-bold Descripcion
                  th.text-uppercase.fw-bold Valor
              tbody
                tr.table-primary
                  td Primary
                  td Operacion completada
                  td +$1,250.00
                tr.table-success
                  td Success
                  td Pago verificado
                  td +$480.00
                tr.table-warning
                  td Warning
                  td En revision
                  td $0.00
                tr.table-danger
                  td Danger
                  td Transaccion cancelada
                  td -$120.00
                tr.table-info
                  td Info
                  td Notificacion enviada
                  td N/A

    .col-lg-6
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 Striped Compact Table
        .bg-body.p-3
          .table-responsive
            table.table.table-striped.align-middle.table-sm.m-0
              thead
                tr
                  th.text-uppercase.fw-bold #
                  th.text-uppercase.fw-bold Producto
                  th.text-uppercase.fw-bold Categoria
                  th.text-end.text-uppercase.fw-bold Stock
              tbody
                tr
                  td 1
                  td Monitor 4K 27"
                  td Hardware
                  td.text-end 14
                tr
                  td 2
                  td Teclado Mecanico
                  td Perifericos
                  td.text-end 28
                tr
                  td 3
                  td Mouse Inalambrico
                  td Perifericos
                  td.text-end 45
                tr
                  td 4
                  td Cable USB-C 2m
                  td Accesorios
                  td.text-end 120