.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#progress.mb-3 Progress Bars & Meters

  .row.g-3.mb-3
    //- Standard & Labeled
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Basic & Labeled Progress
          
          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Default (25%)
          .progress.mb-3
            .progress-bar(role='progressbar' style='width: 25%;' aria-valuenow='25' aria-valuemin='0' aria-valuemax='100')
          
          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Con Porcentaje Visible (50%)
          .progress.mb-3
            .progress-bar.bg-info(role='progressbar' style='width: 50%;' aria-valuenow='50' aria-valuemin='0' aria-valuemax='100') 50%

          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Meta Alcanzada (100%)
          .progress
            .progress-bar.bg-success(role='progressbar' style='width: 100%;' aria-valuenow='100' aria-valuemin='0' aria-valuemax='100') Completado

    //- Striped, Animated & Stacked
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Striped, Animated & Stacked
          
          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Animado (Procesando)
          .progress.mb-3
            .progress-bar.progress-bar-striped.progress-bar-animated.bg-primary(role='progressbar' style='width: 75%;' aria-valuenow='75' aria-valuemin='0' aria-valuemax='100')
          
          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Barras Apiladas (Multiple Segments)
          .progress.mb-3
            .progress-bar.bg-primary(role='progressbar' style='width: 25%;' aria-valuenow='25' aria-valuemin='0' aria-valuemax='100') 25%
            .progress-bar.bg-success(role='progressbar' style='width: 35%;' aria-valuenow='35' aria-valuemin='0' aria-valuemax='100') 35%
            .progress-bar.bg-warning(role='progressbar' style='width: 20%;' aria-valuenow='20' aria-valuemin='0' aria-valuemax='100') 20%

          h6.text-muted.small.text-uppercase.fw-bold.mb-1 Mini Track (4px)
          .progress(style='height: 4px;')
            .progress-bar.bg-danger(role='progressbar' style='width: 85%;' aria-valuenow='85' aria-valuemin='0' aria-valuemax='100')