.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#forms.mb-3 Forms & Form Controls

  .row.g-3
    //- COLUMNA 1: Controles Estándar
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          form
            fieldset
              legend.h4.mb-3 Standard Form Controls
              
              //- Static Control
              .mb-3.row
                label.col-sm-3.col-form-label(for='staticEmail') Email
                .col-sm-9
                  input#staticEmail.form-control-plaintext(type='text' readonly='' value='email@example.com')
              
              //- Text Inputs
              .mb-3
                label.form-label(for='exampleInputEmail1') Email address
                input#exampleInputEmail1.form-control(type='email' aria-describedby='emailHelp' placeholder='Enter email')
                small#emailHelp.form-text.text-muted We will never share your email with anyone else.
              
              .mb-3
                label.form-label(for='exampleInputPassword1') Password
                input#exampleInputPassword1.form-control(type='password' placeholder='Password' autocomplete='off')
              
              //- Selects
              .mb-3
                label.form-label(for='exampleSelect1') Example select
                select#exampleSelect1.form-select
                  option 1
                  option 2
                  option 3
                  option 4
                  option 5
              
              //- Datalist
              .mb-3
                label.form-label(for='exampleDataList') Datalist search
                input#exampleDataList.form-control(list='datalistOptions' placeholder='Type to search...')
                datalist#datalistOptions
                  option(value='San Francisco')
                  option(value='New York')
                  option(value='Seattle')
                  option(value='Los Angeles')
                  option(value='Chicago')

              //- Textarea
              .mb-3
                label.form-label(for='exampleTextarea') Example textarea
                textarea#exampleTextarea.form-control(rows='3')
              
              //- File Input
              .mb-3
                label.form-label(for='formFile') File input
                input#formFile.form-control(type='file')

              //- Radios & Checkboxes
              .row.g-3.mb-3
                .col-sm-6
                  label.form-label Radio buttons
                  .form-check
                    input#optionsRadios1.form-check-input(type='radio' name='optionsRadios' value='option1' checked='')
                    label.form-check-label(for='optionsRadios1') Active option
                  .form-check
                    input#optionsRadios2.form-check-input(type='radio' name='optionsRadios' value='option2')
                    label.form-check-label(for='optionsRadios2') Secondary option
                  .form-check.disabled
                    input#optionsRadios3.form-check-input(type='radio' name='optionsRadios' value='option3' disabled='')
                    label.form-check-label(for='optionsRadios3') Disabled option
                
                .col-sm-6
                  label.form-label Checkboxes & Switches
                  .form-check
                    input#flexCheckDefault.form-check-input(type='checkbox' value='')
                    label.form-check-label(for='flexCheckDefault') Default checkbox
                  .form-check
                    input#flexCheckChecked.form-check-input(type='checkbox' value='' checked='')
                    label.form-check-label(for='flexCheckChecked') Checked checkbox
                  .form-check.form-switch
                    input#flexSwitchCheckChecked.form-check-input(type='checkbox' checked='')
                    label.form-check-label(for='flexSwitchCheckChecked') Switch toggle

              //- Ranges
              .mb-3
                label.form-label(for='customRange1') Range Slider
                input#customRange1.form-range(type='range')

    //- COLUMNA 2: Estados, Tamaños y Agrupaciones
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          form
            h4.mb-3 Validation & Input Groups
            
            //- Validation States
            .mb-3
              label.form-label(for='inputValid') Valid Input
              input#inputValid.form-control.is-valid(type='text' value='Correct value')
              .valid-feedback Field verified successfully.
            
            .mb-3
              label.form-label(for='inputInvalid') Invalid Input
              input#inputInvalid.form-control.is-invalid(type='text' value='Wrong value')
              .invalid-feedback Please provide a valid value.
            
            //- Sizing
            .mb-3
              label.form-label(for='inputLarge') Large input (.form-control-lg)
              input#inputLarge.form-control.form-control-lg(type='text' placeholder='.form-control-lg')
            
            .mb-3
              label.form-label(for='inputSmall') Small input (.form-control-sm)
              input#inputSmall.form-control.form-control-sm(type='text' placeholder='.form-control-sm')
            
            //- Input Groups
            .mb-3
              label.form-label Input groups with addons
              .input-group.mb-2
                span.input-group-text $
                input.form-control(type='text' aria-label='Amount (to the nearest dollar)' placeholder='0.00')
                span.input-group-text .00
              
              .input-group.mb-2
                input.form-control(type='text' placeholder='Search keyword...' aria-label='Search')
                button.btn.btn-primary.px-3.text-uppercase.small.fw-bold(type='button')
                  i.bi.bi-search.me-1
                  | Buscar

            //- Floating Labels
            .mb-3
              label.form-label Floating labels
              .form-floating.mb-2
                input#floatingInput.form-control(type='email' placeholder='name@example.com')
                label(for='floatingInput') Email address
              .form-floating
                input#floatingPassword.form-control(type='password' placeholder='Password' autocomplete='off')
                label(for='floatingPassword') Password