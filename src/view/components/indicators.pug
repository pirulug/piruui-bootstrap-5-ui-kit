.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#indicators.mb-3 Indicators, Badges & Alerts

  //- ==========================
  //- ALERTS SECTION
  //- ==========================
  .row
    .col-lg-12
      h2.h4.mb-3 Alerts

  .row.g-3.mb-3
    .col-lg-12
      .bs-component
        .alert.alert-dismissible.alert-warning
          button.btn-close(type='button' data-bs-dismiss='alert')
          h4.alert-heading Warning Alert
          p.mb-0
            | Please review your security settings. You have 2 pending updates in your repository. 
            a.alert-link(href='#') View security report
            | .

  .row.g-3.mb-3
    .col-lg-4
      .bs-component
        .alert.alert-dismissible.alert-danger.d-flex.align-items-center
          button.btn-close(type='button' data-bs-dismiss='alert')
          i.bi.bi-exclamation-octagon-fill.fs-4.me-2
          div
            strong Error! 
            | Failed to process request.
    .col-lg-4
      .bs-component
        .alert.alert-dismissible.alert-success.d-flex.align-items-center
          button.btn-close(type='button' data-bs-dismiss='alert')
          i.bi.bi-check-circle-fill.fs-4.me-2
          div
            strong Success! 
            | Profile updated correctly.
    .col-lg-4
      .bs-component
        .alert.alert-dismissible.alert-info.d-flex.align-items-center
          button.btn-close(type='button' data-bs-dismiss='alert')
          i.bi.bi-info-circle-fill.fs-4.me-2
          div
            strong Info! 
            | Maintenance scheduled tonight.

  //- ==========================
  //- BADGES SECTION
  //- ==========================
  .row
    .col-lg-12
      h2.h4.mb-3 Badges & Status Indicators

  .row.g-3.mb-3
    //- Standard Badges
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-2 Solid Badges
          .d-flex.flex-wrap.gap-2.mb-3
            span.badge.bg-primary Primary
            span.badge.bg-secondary Secondary
            span.badge.bg-success Success
            span.badge.bg-danger Danger
            span.badge.bg-warning.text-dark Warning
            span.badge.bg-info.text-dark Info
            span.badge.bg-dark Dark

          h3.h5.text-muted.mb-2 Subtle Badges (Theme Subtles)
          .d-flex.flex-wrap.gap-2
            span.badge.bg-primary-subtle.text-primary Primary Subtle
            span.badge.bg-secondary-subtle.text-secondary Secondary Subtle
            span.badge.bg-success-subtle.text-success Success Subtle
            span.badge.bg-danger-subtle.text-danger Danger Subtle
            span.badge.bg-warning-subtle.text-warning Warning Subtle
            span.badge.bg-info-subtle.text-info Info Subtle

    //- Interactive & Positioned Badges
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-2 Badges in Buttons & Counters
          .d-flex.flex-wrap.align-items-center.gap-3.mb-3
            button.btn.btn-primary(type='button')
              | Mensajes 
              span.badge.bg-light.text-dark.ms-1 4
            
            button.btn.btn-outline-primary.position-relative(type='button')
              i.bi.bi-bell.me-1
              | Notificaciones
              span.position-absolute.top-0.start-100.translate-middle.badge.bg-danger 99+

          h3.h5.text-muted.mb-2 Status Dots
          .d-flex.flex-wrap.align-items-center.gap-3
            .d-flex.align-items-center.gap-1
              span.badge.rounded-circle.p-1.bg-success
              span.small.fw-bold Online
            .d-flex.align-items-center.gap-1
              span.badge.rounded-circle.p-1.bg-warning
              span.small.fw-bold Away
            .d-flex.align-items-center.gap-1
              span.badge.rounded-circle.p-1.bg-danger
              span.small.fw-bold Busy
            .d-flex.align-items-center.gap-1
              span.badge.rounded-circle.p-1.bg-secondary
              span.small.fw-bold Offline
