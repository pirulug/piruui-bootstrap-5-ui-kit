.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#navbars.mb-3 Navbars & Headers

  .row.g-3.mb-3
    //- 1. PRIMARY NAVBAR
    .col-lg-12
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 Primary Header (Dark Theme)
        nav.navbar.navbar-expand-lg.bg-primary(data-bs-theme='dark')
          .container-fluid
            a.navbar-brand(href='#') PiruUI
            button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarColor01' aria-controls='navbarColor01' aria-expanded='false' aria-label='Toggle navigation')
              span.navbar-toggler-icon
            #navbarColor01.collapse.navbar-collapse
              ul.navbar-nav.me-auto
                li.nav-item
                  a.nav-link.active(href='#') Inicio
                    span.visually-hidden (current)
                li.nav-item
                  a.nav-link(href='#') Componentes
                li.nav-item
                  a.nav-link(href='#') Documentacion
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(data-bs-toggle='dropdown' href='#' role='button' aria-haspopup='true' aria-expanded='false') Mas
                  .dropdown-menu
                    a.dropdown-item(href='#') Guia de estilos
                    a.dropdown-item(href='#') Iconos
                    .dropdown-divider
                    a.dropdown-item(href='#') Changelog
              form.d-flex
                input.form-control.me-2(type='search' placeholder='Buscar...')
                button.btn.btn-dark.text-uppercase.small.fw-bold(type='submit') Buscar

    //- 2. DARK NAVBAR & RIGHT ACTIONS
    .col-lg-12
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 Dark Header with Right Actions
        nav.navbar.navbar-expand-lg.bg-dark(data-bs-theme='dark')
          .container-fluid
            a.navbar-brand(href='#') PiruAdmin
            button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarColor02' aria-controls='navbarColor02' aria-expanded='false' aria-label='Toggle navigation')
              span.navbar-toggler-icon
            #navbarColor02.collapse.navbar-collapse
              ul.navbar-nav.me-auto
                li.nav-item
                  a.nav-link.active(href='#') Dashboard
                li.nav-item
                  a.nav-link(href='#') Usuarios
                li.nav-item
                  a.nav-link(href='#') Reportes
              ul.navbar-nav.ms-auto.align-items-center.gap-2
                li.nav-item
                  a.nav-link(href='#') Iniciar Sesion
                li.nav-item
                  a.btn.btn-primary.btn-sm.text-uppercase.fw-bold(href='#') Registrarse

    //- 3. CLEAN LIGHT/BODY NAVBAR
    .col-lg-12
      .bs-component.mb-3
        h3.h5.text-muted.mb-2 Clean Minimal Header (bg-body)
        nav.navbar.navbar-expand-lg.bg-body
          .container-fluid
            a.navbar-brand(href='#') Minimal Brand
            button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarColor04' aria-controls='navbarColor04' aria-expanded='false' aria-label='Toggle navigation')
              span.navbar-toggler-icon
            #navbarColor04.collapse.navbar-collapse
              ul.navbar-nav.me-auto
                li.nav-item
                  a.nav-link.active(href='#') Overview
                li.nav-item
                  a.nav-link(href='#') Integrations
                li.nav-item
                  a.nav-link(href='#') Support
              form.d-flex
                input.form-control.me-2(type='search' placeholder='Filtrar...')
                button.btn.btn-outline-primary.text-uppercase.small.fw-bold(type='submit') Filtrar