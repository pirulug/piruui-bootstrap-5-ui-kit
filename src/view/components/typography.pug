.bs-docs-section
  .page-header
    .row
      .col-lg-12
        h1#typography.mb-3 Typography & Monospace Suite

  //- PRIMERA FILA: Headings, Body Text y Colores
  .row.g-3.mb-3
    //- COL 1: Headings & Display
    .col-lg-4
      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-3 Standard Headings
          h1 Heading 1
          h2 Heading 2
          h3 Heading 3
          h4 Heading 4
          h5 Heading 5
          h6 Heading 6
          
          h3.h5.mt-3.mb-1
            | Fancy Heading
            small.text-body-secondary.ms-2 with faded text
          
          p.lead.mt-2 Lead text: Vivamus sagittis lacus vel augue laoreet rutrum faucibus dolor auctor.

      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-3 Display Headings
          h1.display-1 Display 1
          h1.display-4 Display 4
          h1.display-6 Display 6

    //- COL 2: Body Text & Inline Elements
    .col-lg-4
      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-3 Example Body Text
          p
            | Nullam quis risus eget 
            a(href='#') urna mollis ornare
            |  vel eu leo. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus.
          
          p
            small This line of text is meant to be treated as fine print.
          p
            strong Bold text in Space Mono.
          p
            em Italicized text emphasis.
          
          h3.h5.text-muted.mt-3.mb-2 Inline Styles
          p
            | You can use the mark tag to 
            mark highlight
            |  text.
          p
            del Deleted text style.
          p
            ins Addition to the document.
          p
            u Underlined text.
          p
            | Abbreviation: 
            abbr(title='HyperText Markup Language') HTML
            | .

    //- COL 3: Code & Monospace Fonts
    .col-lg-4
      .bs-component.mb-3
        .bg-body.p-3
          h3.h5.text-muted.mb-3 Monospace & Code Snippets
          p
            | Inline code with Google Sans Code: 
            code &lt;section class="piru-hero"&gt;
          
          pre.p-2.bg-dark.text-light
            code.font-monospace
              | function initTheme() {
              |   const mode = "dark";
              |   console.log(`Theme: ${mode}`);
              | }
          
          p.mt-2
            | Keyboard shortcut: 
            kbd Ctrl
            |  + 
            kbd Shift
            |  + 
            kbd P

          h3.h5.text-muted.mt-3.mb-2 Emphasis Colors
          .d-flex.flex-column.gap-1
            p.text-primary.m-0 .text-primary
            p.text-success.m-0 .text-success
            p.text-danger.m-0 .text-danger
            p.text-warning.m-0 .text-warning
            p.text-info.m-0 .text-info
            p.text-body-secondary.m-0 .text-body-secondary

  //- SEGUNDA FILA: Blockquotes & Lists
  .row.g-3.mb-3
    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Blockquotes
          figure.mb-0
            blockquote.blockquote
              p.mb-1 "The details are not the details. They make the design."
            figcaption.blockquote-footer
              | Charles Eames in 
              cite(title='Source Title') Design Philosophy

    .col-lg-6
      .bs-component.mb-3
        .bg-body.p-3
          h2.h4.mb-3 Description Lists
          dl.row.mb-0
            dt.col-sm-4 Space Mono
            dd.col-sm-8 Monospaced sans-serif for high-impact tech typography.
            dt.col-sm-4 Google Sans Code
            dd.col-sm-8 Flexible variable code font for editors and terminal blocks.
            dt.col-sm-4 Bootstrap 5.3
            dd.col-sm-8 Responsive core grid and accessibility foundation.