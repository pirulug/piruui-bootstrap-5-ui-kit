//- layout.pug
include ../config/config
block config
doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    
    //- Primary Meta Tags
    title #{pageTitle ? pageTitle : (siteName + " | " + pageName)}
    meta(name="title" content=pageTitle ? pageTitle : (siteName + " | " + pageName))
    meta(name="description" content=pageDescription ? pageDescription : description)
    meta(name="keywords" content=pageKeywords)
    meta(name="author" content=pageAuthor)
    meta(name="robots" content=pageRobots)
    
    //- Theme Color for Browsers & Mobile
    meta(name="theme-color" content="#ff0055" media="(prefers-color-scheme: light)")
    meta(name="theme-color" content="#111111" media="(prefers-color-scheme: dark)")

    //- Open Graph / Facebook
    meta(property="og:type" content=pageOgType)
    meta(property="og:site_name" content=siteName)
    meta(property="og:title" content=pageTitle ? pageTitle : (siteName + " | " + pageName))
    meta(property="og:description" content=pageDescription ? pageDescription : description)
    meta(property="og:image" content=`${assets}${pageOgImage}`)
    if canonicalUrl
      meta(property="og:url" content=canonicalUrl)
      link(rel="canonical" href=canonicalUrl)

    //- Twitter Cards
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:title" content=pageTitle ? pageTitle : (siteName + " | " + pageName))
    meta(name="twitter:description" content=pageDescription ? pageDescription : description)
    meta(name="twitter:image" content=`${assets}${pageOgImage}`)

    //- Favicon
    link(rel="apple-touch-icon" sizes="180x180" href=`${assets}img/favicon/apple-touch-icon.png`)
    link(rel="icon" type="image/png" sizes="32x32" href=`${assets}img/favicon/favicon-32x32.png`)
    link(rel="icon" type="image/png" sizes="16x16" href=`${assets}img/favicon/favicon-16x16.png`)
    link(rel="manifest" href=`${assets}img/favicon/site.webmanifest`)

    //- Structured Data (JSON-LD)
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "PiruUI",
        "applicationCategory": "DesignSystem",
        "operatingSystem": "All",
        "description": "Modern, borderless, and lightweight Bootstrap 5 UI Kit for developers.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }

    //- Stylesheets
    link(rel="stylesheet" href=`${assets}plugins/prism/prism.css`)
    link(rel="stylesheet" href=`${assets}plugins/bootstrapicons/bootstrapicons.css` media="print" onload="this.media='all'")
    link(rel="stylesheet" href=`${assets}plugins/fontawesome/fontawesome.css` media="print" onload="this.media='all'")
    link(rel="stylesheet" href=`${assets}css/piruui-fonts.css`)
    link(rel="stylesheet" href=`${assets}css/piruui.css`)
    link(rel="stylesheet" href=`${assets}plugins/extra/extra.css`)

    script.
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (prefersDarkScheme ? "dark" : "light");
        document.documentElement.setAttribute("data-bs-theme", theme);
      })();

    block styles
  body
    .piru-wrapper
      include ../includes/navbar
      
      main.piru-main-content
        block content

      include ../includes/footer

    //- Scripts
    script(src=`${assets}js/piruui.js`)
    script(src=`${assets}plugins/prism/prism.js`)

    block scripts
