header.piru-nav-wrapper
  //- Announcement Bar
  .piru-announcement-bar.bg-primary.text-dark#announcementBar
    .container.position-relative
      .d-flex.align-items-center.justify-content-center.gap-2.gap-md-3.flex-wrap.text-center.py-2.pe-4.pe-md-0
        .fw-bold.small
          | Nuevo curso disponible
          i.bi.bi-arrow-right.mx-1
          a.text-reset.text-decoration-underline(href="#" target="_blank") Skills y rules de IA para programadores
          |  ¡Cómpralo con descuento! Solo quedan:
        
        .d-flex.align-items-center.gap-1
          span.badge.bg-dark.bg-opacity-10.text-dark.fw-bold.px-2.py-1
            span.font-monospace 05
            span.small.ms-1 D
          span.badge.bg-dark.bg-opacity-10.text-dark.fw-bold.px-2.py-1
            span.font-monospace 18
            span.small.ms-1 H
          span.badge.bg-dark.bg-opacity-10.text-dark.fw-bold.px-2.py-1
            span.font-monospace 05
            span.small.ms-1 M
          span.badge.bg-dark.bg-opacity-10.text-dark.fw-bold.px-2.py-1
            span.font-monospace 06
            span.small.ms-1 S
      
      button.announcement-close#closeAnnouncement(type="button" aria-label="Cerrar aviso")
        i.bi.bi-x-lg

  //- Main Navigation
  nav.piru-nav-main
    .piru-nav-container
      //- Logo
      a.piru-nav-brand(href=`${baseUrl}index.html` aria-label=siteName)
        if navLogoStyle === 'image'
          .piru-nav-logo-images
            img.piru-logo.logo-light(src=`${assets}${logoLight || 'img/logo/piruui-dark-logo.png'}` alt=siteName)
            img.piru-logo.logo-dark(src=`${assets}${logoDark || 'img/logo/piruui-white-logo.png'}` alt=siteName)
        else if navLogoStyle === 'image-title'
          .piru-nav-logo-image-title
            img.piru-logo.logo-light(src=`${assets}${logoLight || 'img/logo/logo-dark.png'}` alt=siteName)
            img.piru-logo.logo-dark(src=`${assets}${logoDark || 'img/logo/logo-light.png'}` alt=siteName)
            span= siteName
        else
          .piru-nav-logo-text
            i.bi.bi-lightning-charge-fill
            span= siteName

      //- Main Menu
      ul.piru-nav-menu
        li.piru-nav-dropdown.has-megamenu
          a.piru-nav-link(href="#" role="button" aria-expanded="false" aria-haspopup="true")
            span Explore
            i.bi.bi-chevron-down
          .piru-dropdown-panel.piru-megamenu
            .piru-megamenu-grid
              .piru-megamenu-column
                h6 Media & Content
                a.piru-dropdown-item(href=`${baseUrl}movies/movies.html`)
                  span Movies
                a.piru-dropdown-item(href=`${baseUrl}movies/series-details.html`)
                  span Series
                a.piru-dropdown-item(href=`${baseUrl}blog/blog.html`)
                  span Blog
                a.piru-dropdown-item(href=`${baseUrl}colors.html`)
                  span Color Palette
              
              .piru-megamenu-column
                h6 UI Components
                a.piru-dropdown-item(href=`${baseUrl}index.html#buttons`)
                  span Buttons
                a.piru-dropdown-item(href=`${baseUrl}index.html#forms`)
                  span Forms
                a.piru-dropdown-item(href=`${baseUrl}index.html#modals`)
                  span Modals & Tabs
                a.piru-dropdown-item(href=`${baseUrl}index.html#alerts`)
                  span Alerts & Badges

              .piru-megamenu-column
                h6 Resources & Shop
                a.piru-dropdown-item(href=`${baseUrl}pages/sticky-footer-navbar.html`)
                  span Sticky Footer Navbar
                a.piru-dropdown-item(href=`${baseUrl}colors.html`)
                  span Colors & Tokens
                hr.my-2.opacity-10
                a.piru-dropdown-item.featured-item(href=`${baseUrl}shop/index.html`)
                  .d-flex.flex-column
                    .fw-bold.mb-1 Visit Our Shop
                    .small.opacity-75 Premium templates & UI kits
        
        li.piru-nav-dropdown
          a.piru-nav-link(href="#" role="button" aria-expanded="false" aria-haspopup="true")
            span Shop
            i.bi.bi-chevron-down
          .piru-dropdown-panel
            a.piru-dropdown-item(href=`${baseUrl}shop/index.html`)
              span Catalog
            a.piru-dropdown-item(href=`${baseUrl}shop/cart.html`)
              span Cart
            a.piru-dropdown-item(href=`${baseUrl}shop/checkout.html`)
              span Checkout

        li
          a.piru-nav-link(href=`${baseUrl}colors.html`)
            span Colors

        li
          a.piru-nav-link(href=`${baseUrl}pages/sticky-footer-navbar.html`)
            span Sticky Footer

        li.piru-mobile-auth
          .d-grid.gap-2.pt-3
            a.btn.btn-primary.fw-bold(href=`${baseUrl}auth/signup.html`) Get Started
            a.btn.btn-outline-secondary.fw-bold(href=`${baseUrl}auth/signin.html`) Login

      //- Actions
      .piru-nav-actions
        button#openSearch.piru-action-btn(type="button" title="Search" aria-label="Buscar")
          i.bi.bi-search

        button#bd-theme-toggle.piru-action-btn.desktop-only(type="button" title="Cambiar tema" aria-label="Cambiar tema")
          span.theme-icon-active
            i.bi.bi-sun

        .desktop-auth
          a.btn.btn-sm.btn-link.text-body.text-decoration-none.fw-bold(href=`${baseUrl}auth/signin.html`) Login
          a.btn.btn-sm.btn-primary.px-3.fw-bold(href=`${baseUrl}auth/signup.html`) Sign Up

        button#bd-theme-toggle-mobile.piru-action-btn.mobile-only(type="button" title="Cambiar tema" aria-label="Cambiar tema")
          span.theme-icon-active
            i.bi.bi-sun
        
        button.piru-nav-toggle(type="button" aria-label="Alternar menú" aria-expanded="false")
          span
          span
          span

  //- Search Overlay
  #piruSearchOverlay.piru-search-overlay
    .piru-nav-container
      .d-flex.align-items-center.gap-3.w-100
        i.bi.bi-search.text-primary.h5.mb-0
        input#piruSearchInput.form-control.form-control-lg.bg-transparent.border-0.ps-0.shadow-none(type="text" placeholder="Buscar componentes, páginas, recursos..." aria-label="Buscar")
        button#closeSearch.btn.btn-link.text-body.p-0(type="button" aria-label="Cerrar búsqueda")
          i.bi.bi-x-lg.h5.mb-0
