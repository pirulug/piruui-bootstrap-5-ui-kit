//- Top Bar (Scrolls away)
.piru-nav-topbar
  .piru-nav-container
    .d-flex.justify-content-between.align-items-center.w-100
      .d-flex.gap-3
        a.top-link(href="mailto:hello@pirulug.com")
          i.bi.bi-envelope.me-1
          span hello@pirulug.com
        a.top-link(href="#")
          i.bi.bi-telephone.me-1
          span +51 999 888 777
      
      .d-flex.align-items-center.gap-3
        a.top-link(href="#") Terms & Conditions
        .vr.bg-body-secondary(style="height: 12px; width: 1px;")
        .d-flex.gap-2
          a.top-social(href="#" title="Facebook"): i.bi.bi-facebook
          a.top-social(href="#" title="Twitter"): i.bi.bi-twitter-x
          a.top-social(href="#" title="Instagram"): i.bi.bi-instagram
          a.top-social(href="#" title="LinkedIn"): i.bi.bi-linkedin

//- Main Navigation (Sticky)
nav.piru-nav-main
  .piru-nav-container
    //- Logo
    a.piru-nav-brand(href=`${baseUrl}index.html`)
      i.bi.bi-lightning-charge-fill
      span PiruUI

    //- Main Menu
    ul.piru-nav-menu
      li.piru-nav-dropdown
        a.piru-nav-link
          i.bi.bi-grid-1x2
          span Explore
          i.bi.bi-chevron-down
        .piru-dropdown-panel
          a.piru-dropdown-item(href=`${baseUrl}movies/movies.html`)
            i.bi.bi-film
            span Movies
          a.piru-dropdown-item(href=`${baseUrl}movies/series-details.html`)
            i.bi.bi-tv
            span Series
          a.piru-dropdown-item(href=`${baseUrl}blog/blog.html`)
            i.bi.bi-newspaper
            span Blog
      
      li.piru-nav-dropdown
        a.piru-nav-link
          i.bi.bi-bag
          span Shop
          i.bi.bi-chevron-down
        .piru-dropdown-panel
          a.piru-dropdown-item(href=`${baseUrl}shop/index.html`)
            i.bi.bi-grid
            span Catalog
          a.piru-dropdown-item(href=`${baseUrl}shop/cart.html`)
            i.bi.bi-cart
            span Cart
          a.piru-dropdown-item(href=`${baseUrl}shop/checkout.html`)
            i.bi.bi-credit-card
            span Checkout

      li
        a.piru-nav-link(href=`${baseUrl}colors.html`)
          i.bi.bi-palette
          span Colors

      li.piru-mobile-auth
        .d-grid.gap-2
          a.btn.btn-primary.py-3.fw-bold(href=`${baseUrl}auth/signup.html`) Get Started
          a.btn.btn-link.text-body.fw-bold(href=`${baseUrl}auth/signin.html`) Login

    //- Actions
    .piru-nav-actions
      button#openSearch.piru-action-btn(type="button" title="Search")
        i.bi.bi-search

      button#bd-theme-toggle.piru-action-btn.desktop-only(type="button" title="Theme")
        span.theme-icon-active
          i.bi.bi-sun

      .desktop-auth
        a.btn.btn-sm.btn-link.text-body.text-decoration-none.fw-bold(href=`${baseUrl}auth/signin.html`) Login
        a.btn.btn-sm.btn-primary.px-3.fw-bold(href=`${baseUrl}auth/signup.html`) Sign Up

      button#bd-theme-toggle-mobile.piru-action-btn.mobile-only(type="button")
        span.theme-icon-active
          i.bi.bi-sun
      
      button.piru-nav-toggle(aria-label="Menu")
        span
        span
        span

  //- Search Overlay
  #piruSearchOverlay.piru-search-overlay
    .piru-nav-container
      .d-flex.align-items-center.gap-3.w-100
        i.bi.bi-search.text-primary.h4.mb-0
        input#piruSearchInput.form-control.form-control-lg.bg-transparent.border-0.ps-0.shadow-none(type="text" placeholder="Search...")
        button#closeSearch.btn.btn-link.text-body.p-0
          i.bi.bi-x-lg.h4
