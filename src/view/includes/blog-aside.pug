//- Search Widget
.mb-5.card
  .card-body.p-4
    h5.fw-bold.mb-4 Search
    .input-group.bg-body-secondary.p-1.rounded
      input.form-control.bg-transparent.border-0.ps-3.shadow-none(type='text' placeholder='Search here...' aria-label='Search')
      button.btn.btn-primary.px-4.rounded(type='button') 
        i.bi.bi-search

//- Categories Widget
.mb-5.card
  .card-body.p-4
    h5.fw-bold.mb-4 Categories
    .d-flex.flex-wrap.gap-2
      each cat in ['Web Design', 'HTML/Pug', 'Tutorials', 'JavaScript', 'CSS/SASS', 'Freebies']
        a.badge.bg-body-secondary.text-body-secondary.text-decoration-none.px-3.py-2.hover-primary(href='#!')= cat

//- Side Widget
.mb-5.p-4.bg-primary.bg-opacity-10.rounded
  .d-flex.align-items-center.gap-2.mb-3
    i.bi.bi-info-circle-fill.text-primary
    h5.fw-bold.text-primary.mb-0 PiruUI Admin
  p.text-body-secondary.small.mb-0 This is a custom sidebar widget that uses soft backgrounds and rounded corners to highlight important information without overwhelming the interface.

