extends ../layouts/home

append config
  -pageName = 'Home'

block styles
  link(rel="stylesheet" href=`${assets}css/custom.css`)
  script(src=`${assets}js/liteyoutube.js`) 

block scripts 
  script(src=`${assets}js/custom.js`)

block content
  header.piru-hero.position-relative.overflow-hidden.text-white
    //- Background Image with Overlay
    .piru-hero-bg(style=`background-image: url('${assets}img/hero-bg.png');`)
    .piru-hero-overlay

    .container.position-relative.z-index-1.py-5.py-lg-10
      .row.justify-content-center
        .col-lg-8.text-center
          //- Glass Badge
          .d-inline-flex.align-items-center.gap-2.px-3.py-1.bg-white.bg-opacity-10.border.border-white.border-opacity-10.mb-4.backdrop-blur-sm
            span.badge.bg-primary v2.0
            span.small.fw-medium New version available
          
          //- Main Title
          h1.display-1.fw-black.mb-3.ls-tight
            | Design the future with 
            span.text-gradient-primary PiruUI
          
          //- Description
          p.lead.mb-5.text-white-50.fs-4.mx-auto(style="max-width: 600px;")
            | A premium UI kit based on Bootstrap 5 for creating modern, fast, and fully customizable interfaces.
          
          //- CTAs
          .d-flex.flex-column.flex-sm-row.justify-content-center.gap-3
            a.btn.btn-primary.btn-lg.px-5.py-3.fw-bold.shadow-lg-primary(href='#buttons')
              i.bi.bi-rocket-takeoff-fill.me-2
              | Get Started
            a.btn.btn-outline-white.btn-lg.px-5.py-3.fw-bold.backdrop-blur-sm(href='https://github.com' target='_blank')
              i.bi.bi-github.me-2
              | View on GitHub

      //- Floating Scroll Indicator
      .piru-scroll-indicator.d-none.d-md-flex
        i.bi.bi-mouse.fs-4.mb-2
        .piru-scroll-dot

  .container
    //
      Navbar
      ==================================================

    include ../components/navbars.pug

    //
      Buttons
      ==================================================
    
    include ../components/buttons.pug

    //
      Typography
      ==================================================
    
    include ../components/typography.pug

    //
      Tables
      ==================================================
    
    include ../components/tables.pug
          
    //
      Forms
      ==================================================

    include ../components/forms.pug

    //
      Navs
      ==================================================

    include ../components/navs.pug

    //
      Indicators
      ==================================================

    include ../components/indicators.pug
    
    //
      Progress
      ==================================================

    include ../components/progress.pug
    
    //
      Containers
      ==================================================

    include ../components/containers.pug
    
    //
      Dialogs
      ==================================================

    include ../components/dialogs.pug
  
  #source-modal.modal
    .modal-dialog.modal-xl
      .modal-content
        .modal-header
          h5.modal-title Source Code
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          pre
            code.language-html
            
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Close
          button.btn.btn-primary.btn-copy(type='button') Copy

        
                


