extends ../layouts/home

append config
  - pageName = "Home"
  - pageTitle = "PiruUI | Modern & Lightweight Bootstrap 5 UI Kit"
  - pageDescription = "PiruUI is a modern, borderless, and lightweight Bootstrap 5 UI Kit built for developers. Includes rich components, dark mode, and admin patterns."
  - pageKeywords = "bootstrap 5, ui kit, flat design, responsive ui, developer tools, admin components"

block styles
  link(rel="stylesheet" href=`${assets}plugins/custom/custom.css`)
  script(src=`${assets}plugins/liteyoutube/liteyoutube.js`) 

block scripts 
  script(src=`${assets}plugins/custom/custom.js`)

block content
  header.piru-hero
    .container.piru-hero-content
      .row.justify-content-center
        .col-lg-10.text-center
          //- Tech Badge
          .piru-hero-badge.rounded.mb-3
            span.badge.bg-dark.text-light 3DITION 2026
            span.small.fw-bold.text-uppercase V2.0 ST4BL3
          
          //- Main Title
          h1.piru-hero-title.text-uppercase
            | D3SIGN TH3 FUTUR3
            br
            span.text-white FOR D3V3LOP3RS
          
          //- Description
          p.piru-hero-text
            | TH3 N3W MOD3RN D3SIGN SYST3M B4S3D ON BOOTSTR4P 5. F4ST, FL3XIBL3, 4ND BUILT TO CR34T3 STUNNING INT3RF4C3S.
          
          //- Tech Features Bar
          .piru-hero-tags.d-flex.flex-wrap.justify-content-center.gap-2.mb-4
            span.piru-tag.text-uppercase
              i.bi.bi-code-slash.me-1
              | 100% OP3N SOURC3
            span.piru-tag.text-uppercase
              i.bi.bi-lightning-charge.me-1
              | BOOTSTR4P 5.3
            span.piru-tag.text-uppercase
              i.bi.bi-palette.me-1
              | D4RK & LIGHT MOD3
          
          //- CTAs
          .piru-hero-actions
            a.btn.btn-dark.btn-lg.px-5.py-3.fw-bold.text-uppercase(href='#buttons')
              i.bi.bi-rocket-takeoff.me-2
              | G3T ST4RT3D
            a.btn.btn-outline-dark.btn-lg.px-5.py-3.fw-bold.text-uppercase(href='https://github.com' target='_blank')
              i.bi.bi-github.me-2
              | VI3W ON GITHUB

  .container
    //
      Navbar
      ==================================================

    include ../components/navbars.pug

    //
      Buttons
      ==================================================
    
    include ../components/buttons.pug

    //
      Typography
      ==================================================
    
    include ../components/typography.pug

    //
      Tables
      ==================================================
    
    include ../components/tables.pug
          
    //
      Forms
      ==================================================

    include ../components/forms.pug

    //
      Navs
      ==================================================

    include ../components/navs.pug

    //
      Indicators
      ==================================================

    include ../components/indicators.pug
    
    //
      Progress
      ==================================================

    include ../components/progress.pug
    
    //
      Containers
      ==================================================

    include ../components/containers.pug
    
    //
      Dialogs
      ==================================================

    include ../components/dialogs.pug
  
  #source-modal.modal
    .modal-dialog.modal-xl
      .modal-content
        .modal-header
          h5.modal-title Source Code
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          pre
            code.language-html
            
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Close
          button.btn.btn-primary.btn-copy(type='button') Copy

        
                


