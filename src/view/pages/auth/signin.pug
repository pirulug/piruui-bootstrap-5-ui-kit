extends ../../layouts/auth

append config
  -pageName = 'Sign In'

block content
  .container
    .row.justify-content-center
      .col-md-8.col-lg-6
        //- Card container (borderless & shadowless by rules)
        .card.p-4.p-lg-5
          .text-center.mb-5
            a.d-inline-block.mb-4(href=`${baseUrl}index.html`)
              i.bi.bi-lightning-charge-fill.text-primary.display-4
            h2.fw-bold Welcome Back
            p.text-body-secondary.small Enter your credentials to access your account

          form.d-grid.gap-4
            div
              label.form-label(for='email') Email Address
              input#email.form-control(type='email' placeholder='name@example.com' required)
            
            div
              .d-flex.justify-content-between.align-items-center.mb-2
                label.form-label.mb-0(for='password') Password
                a.small.text-decoration-none(href='#') Forgot password?
              .input-group
                input#password.form-control(type='password' placeholder='••••••••' required)
                button.btn.btn-link.text-body.text-decoration-none.bg-body-secondary.px-3(type="button" data-pr-toggle-password="password")
                  i.bi.bi-eye

            .form-check.small
              input#remember.form-check-input(type='checkbox')
              label.form-check-label.text-body-secondary(for='remember') Remember me for 30 days

            button.btn.btn-primary.btn-lg.fw-bold.py-3(type='submit') Sign In

          .text-center.my-5
            span.small.text-body-secondary.px-3.position-relative(style="z-index: 1;") Or continue with
            hr.mt-n3.text-body-secondary.opacity-25

          .d-grid.gap-3
            button.btn.btn-outline-body.d-flex.align-items-center.justify-content-center.gap-2.py-3.fw-medium(type="button")
              i.bi.bi-google
              span Google Account
            button.btn.btn-outline-body.d-flex.align-items-center.justify-content-center.gap-2.py-3.fw-medium(type="button")
              i.bi.bi-github
              span GitHub Account

          .text-center.mt-5
            p.small.text-body-secondary.mb-0
              | Don't have an account? 
              a.fw-bold.text-decoration-none(href=`${baseUrl}auth/signup.html`) Sign Up
