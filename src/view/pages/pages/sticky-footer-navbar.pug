extends ../../layouts/home

append config
  -pageName = 'Home'

block styles

block scripts 

block content
  .container.my-3
    .row.g-3
      // SIDEBAR DE NAVEGACIÓN
      .col-md-4.col-lg-3
        .card.sticky-top(style='top: 4rem')
          .card-header.p-3
            h6.m-0.fw-bold.text-uppercase.small.text-body-secondary &Aacute;rea Personal
          .list-group.list-group-flush
            a.list-group-item.list-group-item-action.d-flex.align-items-center.gap-2.py-3.active(href='/account/profile')
              i.fa-solid.fa-circle-user.fa-fw
              span.small.fw-bold.text-uppercase Vista General
            a.list-group-item.list-group-item-action.d-flex.align-items-center.gap-2.py-3(href='/account/settings/profile')
              i.fa-solid.fa-user-pen.fa-fw
              span.small.fw-bold.text-uppercase Ajustes de Perfil
            a.list-group-item.list-group-item-action.d-flex.align-items-center.gap-2.py-3(href='/account/settings/password')
              i.fa-solid.fa-shield-halved.fa-fw
              span.small.fw-bold.text-uppercase Seguridad
            a.list-group-item.list-group-item-action.d-flex.align-items-center.gap-2.py-3(href='/account/settings/api')
              i.fa-solid.fa-plug.fa-fw
              span.small.fw-bold.text-uppercase Conexiones API
      // CONTENIDO PRINCIPAL
      .col-md-8.col-lg-9
        // HEADER DE PERFIL
        .card.mb-3.overflow-hidden(style='background: linear-gradient(135deg, var(--pr-primary) 0%, #6610f2 100%); border: none;')
          .card-body.p-3.p-md-4
            .d-flex.flex-column.flex-md-row.align-items-center.gap-3.text-center.text-md-start
              .position-relative
                img.border.border-3.border-white.border-opacity-25(alt='Admin' src='http://php-start.test/storage/uploads/user/default.webp' style='width: 100px; height: 100px; object-fit: cover; border-radius: 20px;')
                span.position-absolute.bottom-0.end-0.bg-success.border.border-white.border-2.rounded-circle(style='width: 18px; height: 18px;' title='Activo ahora')
              .text-white
                h3.fw-bold.mb-1 Admin
                .d-flex.align-items-center.justify-content-center.justify-content-md-start.gap-2.mb-3
                  span.badge.bg-white.bg-opacity-25.text-white.px-2.py-1.text-uppercase.fw-bold(style='font-size: 0.65rem;')
                    | Administrador
                  span.text-white-50.small
                    i.fa-solid.fa-at.me-1
                    | admin
                .d-flex.flex-wrap.justify-content-center.justify-content-md-start.gap-2
                  a.btn.btn-light.btn-sm.px-4.text-uppercase.small.fw-bold(href='/account/settings/profile')
                    i.fa-solid.fa-user-gear.me-2
                    |  Configurar Perfil
        // TABLA DE INFORMACIÓN
        .card.mb-3
          .card-header.py-3.ps-4
            h6.card-title.mb-0.fw-bold.text-uppercase
              i.fa-solid.fa-circle-info.me-2.text-primary
              | Resumen de la Cuenta
          .card-body.p-0
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                tbody
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small(style='width: 220px;') Email de contacto
                    td.pe-4.py-3.fw-medium.text-body admin@gmail.com
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small Nombre registrado
                    td.pe-4.py-3.fw-medium.text-body
                      | Administrador
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small Username
                    td.pe-4.py-3.text-body admin
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small Rango / Nivel
                    td.pe-4.py-3
                      span.badge.bg-primary-subtle.text-primary.text-uppercase.fw-bold(style='font-size: 0.7rem;') Administrador
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small Miembro desde
                    td.pe-4.py-3.small.text-body-secondary
                      i.fa-regular.fa-calendar-check.me-1
                  tr
                    td.ps-4.py-3.text-body-secondary.text-uppercase.fw-bold.small Actividad reciente
                    td.pe-4.py-3.small.text-body-secondary
                      i.fa-regular.fa-clock.me-1
