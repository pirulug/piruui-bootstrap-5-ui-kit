extends ../../layouts/home

append config
  -pageName = 'Movie Details'

block content
  //- Hero Section with Backdrop
  section.position-relative.overflow-hidden.py-5.bg-dark.text-white(style=`min-height: 500px; background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('${assets}img/movie/backdrop.webp') center/cover no-repeat;`)
    .container.py-lg-5
      .row.align-items-center.gy-4
        .col-lg-3.col-md-4
            img.img-fluid.rounded(src=`${assets}img/movie/poster.webp` alt="Poster")
        
        .col-lg-9.col-md-8
            .badge.bg-primary.mb-3 World Premiere
            h1.fw-bold.display-3.mb-2 Oppenheimer
            .d-flex.align-items-center.gap-3.mb-4.text-white-50
                span.d-flex.align-items-center.gap-1
                    i.bi.bi-star-fill.text-warning
                    | 8.9 / 10
                span.vr
                span 2h 20m
                span.vr
                span Drama, History
                span.vr
                span 2023
            
            p.lead.mb-5.opacity-75 During World War II, brilliant physicist J. Robert Oppenheimer is recruited by the U.S. government to lead the Manhattan Project, an ambitious secret mission to develop the world's first atomic bomb.
            
            .d-flex.gap-3
                button.btn.btn-primary.btn-lg.px-4
                    i.bi.bi-play-fill.me-2
                    | Watch Trailer
                button.btn.btn-outline-light.btn-lg.px-4
                    i.bi.bi-bookmark.me-2
                    | Add to My List

  //- Details Section
  .container.py-5
    .row.gy-5
      .col-lg-8
        h3.fw-bold.mb-4 Full Synopsis
        p.text-body-secondary Physicist J. Robert Oppenheimer works with a team of scientists during the Manhattan Project, leading to the development of the atomic bomb. His life changes forever as he becomes the "father of the atomic bomb," facing moral and political dilemmas after the weapon's use in Hiroshima and Nagasaki.
        
        hr.my-5.opacity-10
        
        h3.fw-bold.mb-4 Main Cast
        .row.g-3
            each actor in ['Cillian Murphy', 'Emily Blunt', 'Matt Damon', 'Robert Downey Jr.', 'Florence Pugh', 'Josh Hartnett']
                .col-6.col-md-4
                    .d-flex.align-items-center.gap-3.p-2.rounded.bg-body
                        .avatar.rounded-circle.bg-secondary(style="width: 48px; height: 48px;")
                        div
                            .fw-bold.small= actor
                            .text-muted.x-small Actor
      
      .col-lg-4
        .card.p-4
            h5.fw-bold.mb-4 Technical Details
            ul.list-unstyled.d-grid.gap-3.mb-0
                li.d-flex.justify-content-between.small
                    span.text-muted Director
                    span.fw-medium Christopher Nolan
                li.d-flex.justify-content-between.small
                    span.text-muted Screenplay
                    span.fw-medium Christopher Nolan
                li.d-flex.justify-content-between.small
                    span.text-muted Studio
                    span.fw-medium Universal Pictures
                li.d-flex.justify-content-between.small
                    span.text-muted Language
                    span.fw-medium English
                li.d-flex.justify-content-between.small
                    span.text-muted Budget
                    span.fw-medium $100.0M
                li.d-flex.justify-content-between.small
                    span.text-muted Box Office
                    span.fw-medium $960.2M

    hr.my-5.opacity-10
    
    //- Related Movies
    h3.fw-bold.mb-4 Recommended Movies
    .row.g-4
        each movie in ['Barbie', 'Dune: Part Two', 'Interstellar', 'Inception']
            .col-6.col-md-3
                a.text-decoration-none(href="#")
                    .card.overflow-hidden
                        img.card-img-top(src=`${assets}img/movie/poster.webp` alt=movie style="aspect-ratio: 2/3; object-fit: cover;")
                        .card-body.p-3
                            h6.fw-bold.mb-0.text-body= movie
