extends ../../layouts/home

append config
  -pageName = 'Movies'

block content
  .container.py-5
    header.mb-5
        h1.fw-bold.display-4 Featured Movies
        p.text-body-secondary.lead Explore the latest trending movies and premium UI components.
    
    .row.g-4
      //- Movie Card 1
      .col-sm-6.col-md-4.col-lg-3
        a.text-decoration-none(href=`${baseUrl}movies/movie-details.html`)
            .piru-movie-card.rounded.overflow-hidden
              .piru-movie-poster-wrapper
                img.img-fluid.w-100(src="https://dummyimage.com/600x900/181818/ffffff&text=Oppenheimer" alt="Movie")
                .piru-movie-overlay
                  .piru-movie-badge 4K
                  h5.fw-bold.text-white.mb-1 Oppenheimer
                  .piru-movie-meta
                    span 2023
                    span •
                    span 3h 0min
              .py-3
                h6.fw-bold.mb-1.text-body Oppenheimer
                p.small.text-muted.mb-0 Drama, History
      
